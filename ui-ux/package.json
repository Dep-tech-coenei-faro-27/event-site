{
  "name": "enei-ui-ux",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node ./scripts/build-css.mjs && node ./scripts/build-admin-pages.mjs",
    "build:min": "node ./scripts/build-css.mjs --minify && node ./scripts/build-admin-pages.mjs",
    "dev": "node ./scripts/watch-css.mjs",
    "format": "prettier --write \"**/*.{html,css,js,json,md}\" && prettier --write \"assets/**/*.svg\" --parser html",
    "format:check": "prettier --check \"**/*.{html,css,js,json,md}\" && prettier --check \"assets/**/*.svg\" --parser html"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "tailwindcss": "3.4.19"
  }
}
