PROJECT_NAME=event-site-backend
# dev: aceita configuração de desenvolvimento. prod (o valor por omissão): recusa arrancar com segredos fracos.
ENVIRONMENT=dev
DEBUG=false
MAX_REQUEST_BYTES=1048576
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Gerar com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-secret-replace-me-0123456789abcdef
# Assina os QR codes dos bilhetes emitidos. Tem de ser diferente da JWT_SECRET_KEY.
QR_SECRET_KEY=dev-only-qr-secret-replace-me-0123456789abcdef
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ACCESS_TOKEN_LONG_EXPIRE_MINUTES=10080
JWT_EMAIL_VERIFICATION_EXPIRE_MINUTES=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=auto
SMTP_TIMEOUT_SECONDS=5
SMTP_USER=
SMTP_PASSWORD=
EMAIL_SENDER=
# Emails que o primeiro SMTP pode enviar por dia UTC (0: sem limite conhecido).
SMTP_DAILY_LIMIT=0
# Segundo SMTP, de reserva: só envia quando o primeiro esgota a quota ou falha.
SMTP2_HOST=
SMTP2_PORT=587
SMTP2_SECURITY=auto
SMTP2_USER=
SMTP2_PASSWORD=
SMTP2_EMAIL_SENDER=
FRONTEND_URL=http://localhost:3000
FRONTEND_VERIFY_PATH=/conta/verificar
FRONTEND_RESET_PATH=/conta/redefinir
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_LOGIN_PER_EMAIL_PER_MINUTE=20
RATE_LIMIT_LOGIN_PER_IP_PER_MINUTE=300
RATE_LIMIT_REGISTER_PER_MINUTE=2
RATE_LIMIT_EMAIL_PER_MINUTE=1
RATE_LIMIT_EMAIL_PER_HOUR=5
RATE_LIMIT_EMAIL_PER_IP_PER_MINUTE=10
RATE_LIMIT_PASSWORD_CHANGE_PER_15_MINUTES=2
RATE_LIMIT_TOKEN_PER_IP_PER_MINUTE=20
RATE_LIMIT_PAYMENT_PER_MINUTE=10
RATE_LIMIT_PAYMENT_CALLBACK_PER_IP_PER_MINUTE=60
UNVERIFIED_ACCOUNT_TTL_DAYS=7
# Domínios de email institucional que verificam o estudante automaticamente (JSON ou lista separada por vírgulas).
# Cobre também os subdomínios. Em produção o valor vem da Variable STUDENT_EMAIL_DOMAINS do GitHub.
# Comprovativo de matrícula (quem não tem email de aluno). A pasta tem de ficar fora de media/.
# STUDENT_PROOF_DIR=/app/private/student-proofs
# STUDENT_PROOF_MAX_BYTES=1048576
# STUDENT_TRUST_ANCHORS_FILE=
# RATE_LIMIT_STUDENT_PROOF_PER_HOUR=5
# RATE_LIMIT_STUDENT_PROOF_PER_IP_PER_HOUR=20
STUDENT_EMAIL_DOMAINS=["alunos.ulisboa.pt","edu.ulisboa.pt","alunos.fc.ul.pt","campus.ul.pt","edu.fe.up.pt","edu.fc.up.pt","g.uporto.pt","student.uc.pt","student.dei.uc.pt","student.fct.uc.pt","alunos.uminho.pt","pg.uminho.pt","campus.fct.unl.pt","alunos.uevora.pt","alunos.utad.pt","student.uma.pt","my.ipleiria.pt","alunos.isel.pt","alunos.ipl.pt","estudantes.ips.pt","alunos.ipca.pt","alunos.ipv.pt","alunos.estgv.ipv.pt","ipcbcampus.pt","alunos.ipb.pt","agni.ipg.pt","alunos.ipg.pt","alunos.ipvc.pt","stu.ipbeja.pt","alunos.ulusofona.pt","ufp.edu.pt"]
# Modo de pagamentos: off (por omissão) | simulated (dev/staging, sem MB WAY real) | live.
# Os preços vivem na base de dados; abrir a bilheteira com:
#   python -m app.domains.payments.set_price <modalidade> <cêntimos> [--stock N]
PAYMENTS_MODE=simulated
# Gateway usado com PAYMENTS_MODE=live: stripe (por omissão) ou ifthenpay.
PAYMENTS_PROVIDER=stripe
# Stripe MB WAY: chave secreta (sk_test_... no sandbox). Nunca no git.
STRIPE_SECRET_KEY=
# Segredo de assinatura do webhook do Stripe (whsec_...); obrigatório em live com stripe.
STRIPE_WEBHOOK_SECRET=
# ifthenpay MB WAY (só com PAYMENTS_PROVIDER=ifthenpay). PAYMENTS_MODE=live exige MBWAY_KEY, MBWAY_BASE_URL em https e
# MBWAY_CALLBACK_KEY (a chave anti-phishing que o ifthenpay devolve no callback,
# com pelo menos 32 caracteres).
MBWAY_KEY=
MBWAY_BASE_URL=https://api.ifthenpay.com/spg/payment/mbway
MBWAY_AUTH_TOKEN=
MBWAY_CALLBACK_KEY=
MBWAY_TIMEOUT_SECONDS=10
MBWAY_PAYMENT_TIMEOUT_SECONDS=240
# Stripe: um pagamento ainda à espera tantos segundos depois do prazo é cancelado no
# Stripe (liberta o lugar e deixa de poder ser aprovado). Acima da janela real do MB WAY.
# STRIPE_CANCEL_GRACE_SECONDS=120
# Com um valor > 0 o gateway simulado confirma o pagamento ao fim destes segundos
# (testa a confirmação sem ifthenpay). Só é permitido com PAYMENTS_MODE=simulated;
# com live ou off o backend recusa arrancar.
PAYMENTS_SIMULATED_CONFIRM_AFTER_SECONDS=0
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
