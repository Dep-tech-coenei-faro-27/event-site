        auth_client,
        email_sender,
        email="john-doe@example.com",
        password="Password333_!",
    )

    login_response = auth_client.post(
        LOGIN_URL,
        json={
            "email": "john-doe@example.com",
            "password": "Password333_!",
        },
    )

