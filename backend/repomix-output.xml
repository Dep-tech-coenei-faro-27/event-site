def test_register_creates_user(auth_client):
    response = auth_client.post(
        REGISTER_URL,
        json={
            "name": "Ana Silva",
            "email": "ana@example.com",
            "password": "Password123!",
            "accept_terms": True,
            "institution": PortugueseInstitution.ULISBOA.value,
